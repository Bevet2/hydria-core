{
  "name": "@hydria-arena/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/tests/**/*.test.ts",
    "start": "node dist/index.js",
    "knowledge:refresh": "tsx src/scripts/refreshKnowledgeLayer.ts",
    "student:strategy-discovery": "tsx src/scripts/runStudentStrategyDiscoveryLoop.ts",
    "student:temporal-eval": "tsx src/scripts/runStudentTemporalEval.ts",
    "student:temporal-eval:record": "tsx src/scripts/runStudentTemporalEval.ts --acquisition=record --cache=off",
    "student:temporal-eval:replay": "tsx src/scripts/runStudentTemporalEval.ts --acquisition=replay --cache=off"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonrepair": "^3.13.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
