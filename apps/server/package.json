{
  "name": "@hydria-arena/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/tests/**/*.test.ts",
    "start": "node dist/index.js",
    "knowledge:refresh": "tsx src/scripts/refreshKnowledgeLayer.ts",
    "learning:loop": "tsx src/scripts/runLearningLoop.ts",
    "student:training-pack": "tsx src/scripts/runPrepareLocalStudentTrainingPack.ts",
    "student:training-env": "tsx src/scripts/runCheckLocalStudentTrainingEnv.ts",
    "student:baseline": "tsx src/scripts/runFreezeLocalStudentBaseline.ts",
    "student:training-request": "tsx src/scripts/runPrepareLocalStudentTrainingRequest.ts",
    "student:variant-register": "tsx src/scripts/runRegisterLocalStudentVariant.ts",
    "student:variant-ab": "tsx src/scripts/runCompareLocalStudentVariant.ts",
    "student:extended-benchmark": "tsx src/scripts/runLocalStudentExtendedBenchmark.ts",
    "conversation:runtime-mini": "tsx src/scripts/runConversationRuntimeMiniBenchmark.ts",
    "conversation:strategic-conflict": "tsx src/scripts/runStrategicConstraintConflictBenchmark.ts",
    "conversation:strategic-coherence": "tsx src/scripts/runStrategicCoherenceFineBenchmark.ts",
    "runtime:release-gate": "tsx src/scripts/runHydriaCoreRuntimeReleaseGate.ts",
    "persistence:migrate:postgres": "tsx src/scripts/migrateSqliteToPostgres.ts",
    "persistence:postgres:smoke": "tsx src/scripts/runPostgresPersistenceSmoke.ts",
    "persistence:postgres:cutover-check": "tsx src/scripts/runPostgresCutoverCheck.ts",
    "prod:smoke": "tsx src/scripts/runProductionSmoke.ts",
    "prod:chat-routing-gate": "tsx src/scripts/runProductionChatRoutingGate.ts",
    "prod:stable-factual-gate": "tsx src/scripts/runStableFactualChatGate.ts",
    "student:chat-prod-gate": "tsx src/scripts/runStudentChatProductionGate.ts",
    "models:pretraining-gate": "tsx src/scripts/runModelRolePreTrainingGate.ts",
    "models:routing-gate": "tsx src/scripts/runModelRoutingEconomicsGate.ts",
    "models:ops-gate": "tsx src/scripts/runModelRuntimeOpsGate.ts",
    "retrieval:reranker-gate": "tsx src/scripts/runRetrievalRerankerMiniGate.ts",
    "student:strategy-discovery": "tsx src/scripts/runStudentStrategyDiscoveryLoop.ts",
    "student:temporal-eval": "tsx src/scripts/runStudentTemporalEval.ts",
    "student:temporal-eval:record": "tsx src/scripts/runStudentTemporalEval.ts --acquisition=record --cache=off",
    "student:temporal-eval:replay": "tsx src/scripts/runStudentTemporalEval.ts --acquisition=replay --cache=off",
    "tool:routing-eval": "tsx src/scripts/runToolRoutingEval.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonrepair": "^3.13.1",
    "pg": "^8.20.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
