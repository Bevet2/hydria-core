SERVER_PORT=8080
WEB_ORIGIN=http://localhost:5173
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=Hydria Arena
ARENA_RESPONDENT_A_MODEL=openai/gpt-5.4-mini
ARENA_RESPONDENT_B_MODEL=openai/gpt-5.4-mini
ARENA_REDTEAM_MODEL=openai/gpt-5.4-mini
ARENA_JUDGE_MODEL=openai/gpt-5.4-mini
ARENA_SYNTHESIZER_MODEL=openai/gpt-5.4-mini
RESPONDENT_REPAIR_RETRY_ENABLED=true
RESPONDENT_FALLBACK_MODEL=openai/gpt-5.4-mini
ARENA_REFINE_FALLBACK_MODEL=openai/gpt-5.4-mini
OPENROUTER_TIMEOUT_MS=90000
# Optional path overrides.
# If omitted, Hydria resolves project-local defaults from the repo root.
# Prefer absolute paths only if you intentionally want storage outside the repo.
# HISTORY_FILE=
# BENCHMARK_RUNS_FILE=
# KNOWLEDGE_LAYER_FILE=
# KNOWLEDGE_MEMORY_FILE=
# ROUND_DATASET_FILE=
# STUDENT_CURATED_DATASET_FILE=
# STUDENT_CONTRASTIVE_DATASET_FILE=
# STUDENT_SESSION_HISTORY_FILE=
# STUDENT_SESSION_DATASET_FILE=
# STUDENT_RULE_IMPACT_FILE=
# STUDENT_TOOL_IMPACT_FILE=
# STUDENT_STRATEGY_IMPACT_FILE=
# STUDENT_STRATEGY_DISCOVERY_FILE=
# STUDENT_STRATEGY_ASSETS_FILE=
LOCAL_MODEL_PROVIDER=ollama
LOCAL_MODEL_NAME=qwen2.5:3b
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11435
LOCAL_STUDENT_FALLBACK_MODEL=openai/gpt-5.4-mini
LOCAL_MODEL_TIMEOUT_MS=45000
LOCAL_MODEL_OBSERVER_ENABLED=true
OLLAMA_PROJECT_HOST=127.0.0.1:11435
