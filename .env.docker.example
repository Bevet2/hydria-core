OPENROUTER_API_KEY=
LOCAL_MODEL_NAME=student-local-1p5b-toolbench-lora-v10-light:latest
LOCAL_STUDENT_FALLBACK_MODEL=openai/gpt-5.4-mini
PERSISTENCE_ADAPTER=sqlite
# Required only when PERSISTENCE_ADAPTER=postgres.
# POSTGRES_URL=
POSTGRES_SCHEMA=public

# Docker-specific overrides. Keep host-local Windows paths out of this file.
HYDRIA_CORE_PORT=8080
HYDRIA_DOCKER_WEB_ORIGIN=http://localhost:8080
HYDRIA_DOCKER_API_BASE_URL=http://localhost:8080
HYDRIA_DOCKER_HTTP_REFERER=http://localhost:8080
HYDRIA_DOCKER_LOCAL_MODEL_BASE_URL=http://host.docker.internal:11435
HYDRIA_DOCKER_LOCAL_MODEL_OBSERVER_ENABLED=false
